{
  "name": "blackthorn-curse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Blackthorn Curse — a single-player mobile medieval fantasy RPG prototype.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:content": "vitest run tests/content.test.ts"
  },
  "dependencies": {
    "phaser": "3.88.2",
    "zod": "3.24.4"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.4"
  }
}
