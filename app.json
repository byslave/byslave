{
  "expo": {
    "name": "PULSE",
    "slug": "pulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.pulse.nightlife",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "PULSE uses your location to recenter the map and, later, to confirm you are at a venue during a night recording. Location is not tracked continuously and is never shown to other people."
      }
    },
    "android": {
      "package": "app.pulse.nightlife",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#07060C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07060C"
        }
      ],
      "expo-localization",
      "expo-image",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PULSE uses your location to recenter the map and, later, to confirm you are at a venue during a night recording. Location is not tracked continuously and is never shown to other people."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
