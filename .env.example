# Safe to expose in the client. Never put the Supabase service role key here.

# Leave blank to run the labeled demo repository.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Optional. When set, the map loads the Mapbox Dark style. Otherwise OpenFreeMap is used.
EXPO_PUBLIC_MAPBOX_TOKEN=

# Server-only. Do not prefix with EXPO_PUBLIC_ and do not ship in the app binary.
# SUPABASE_SERVICE_ROLE_KEY=

# Official ticket feeds stay off until a contracted key exists. Do not scrape.
ENABLE_BUBILET_FEED=false
ENABLE_BILETIX_FEED=false
ENABLE_PASSO_FEED=false
ENABLE_BUGECE_FEED=false

# Set to true to open the review queue in a production build. Development builds already show it.
# EXPO_PUBLIC_ADMIN=
