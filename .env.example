# OpenAI API anahtarı (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# İsteğe bağlı: varsayılanlar çoğu kullanım için yeterlidir
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
# Ses: nova, shimmer, coral, sage, alloy, echo, onyx, ash, fable
# Arayüzdeki listeden de değiştirebilirsin; burası varsayılan.
OPENAI_TTS_VOICE=nova
OPENAI_BASE_URL=
